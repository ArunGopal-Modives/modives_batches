<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<appSettings>

		<!-- Source (Prod Replica) -->
		<add key="SourceServer" value="myrenter-mysql-prod-replica-eu.mysql.database.azure.com" />
		<add key="SourcePort" value="3306" />
		<add key="SourceDatabase" value="myrenter-data" />
		<add key="SourceUser" value="myrenter_read" />
		<add key="SourcePassword" value="f9Y5obCM28Sz" />

		<!-- Target Analytics -->
		<add key="TargetServer" value="myrenter-mysql-prod.mysql.database.azure.com" />
		<add key="TargetPort" value="3306" />
		<add key="TargetDatabase" value="modives-analytics" />
		<add key="TargetUser" value="analytics_prod" />
		<add key="TargetPassword" value="E0ysad54ddas415" />
		<!-- Billing refresh settings -->
		<!-- Number of days back used for BOTH billing_transactions DELETE and INSERT -->
		<!-- Example: 2 = last 2 days; 7 = last 7 days; 30 = last 30 days -->
		<!-- One-time refresh from 2026-07-01: 102 days back from 2026-10-11. Recalculate if run on another day. -->
		<add key="BillingRefreshDays" value="102" />

		<!-- Dealer contracts refresh settings -->
		<!-- Y = reload dealer_contracts (DealerId, ContractName, ClientName) from the sheet before staging; anything else = skip -->
		<add key="RefreshDealerContracts" value="N" />
		<!-- Full path to the contracts .xlsx (a relative path is resolved against the utility's folder) -->
		<add key="DealerContractsFilePath" value="C:\StagingDataSync_Configurable_Billing_Refresh-new\StagingDataSync_Configurable_Billing_Refresh\Inputs\Hierarchy.xlsx" />
		<!-- Optional sheet name; blank = first sheet -->
		<add key="DealerContractsSheetName" value="Sheet1" />

		<!-- Timeout settings -->
		<add key="ConnectionTimeout" value="60" />
		<add key="CommandTimeout" value="7200" />
		<add key="KeepAlive" value="60" />


	</appSettings>

</configuration>